# Copy to .env; never commit this file with real values.
DATABASE_URL=postgresql://aura:change-me@localhost:5432/aura
REDIS_URL=redis://localhost:6379/0
AURA_DB_PATH=./aura.db # development/test fallback only
AURA_WORKSPACE=./workspace
AURA_API_TOKEN=replace-with-a-long-random-secret
AURA_RATE_LIMIT_PER_MINUTE=60
AURA_MAX_CHANGED_FILES=20
AURA_MAX_CHANGED_BYTES=2097152
AURA_COMMAND_TIMEOUT=300
AURA_MAX_PARALLEL_STEPS=3
AURA_MAX_RETRIES=2
GITHUB_TOKEN=
GITHUB_REPO=owner/repository
GITHUB_BASE_BRANCH=main
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AURA_HOST=127.0.0.1
AURA_PORT=8787
AURA_DEBUG=0
