# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# AURA Gemini Model Configuration (Future-Proof Abstraction)
DEFAULT_MODEL="gemini-3.8-flash"
PLANNER_MODEL="gemini-3.8-flash"
CODER_MODEL="gemini-3.8-flash"
RESEARCH_MODEL="gemini-3.8-flash"
FAST_MODEL="gemini-3.8-flash"

# Database & Cache Persistence (PostgreSQL + pgvector & Redis)
DATABASE_URL="postgresql://aura_user:aura_secure_password@postgres:5432/aura_db"
REDIS_URL="redis://redis:6379/0"

# GitHub Integration
GITHUB_TOKEN=""

# Autonomous Orchestrator Limits & Configuration
MAX_ITERATIONS=10
MAX_RUNTIME=3600
MAX_TOKEN_USAGE=1000000
MAX_FILE_CHANGES=50
MAX_REPAIR_ATTEMPTS=5
AUTONOMOUS_MODE=true
SEARCH_CONFIGURATION="primary_first"

